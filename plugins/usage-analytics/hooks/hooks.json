{
  "description": "Records skill, slash-command and tool usage to a local buffer that is batch-flushed to Grafana Loki",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "PATH=\"$PATH:/usr/local/bin:/opt/homebrew/bin\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/record.mjs\"", "async": true }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "PATH=\"$PATH:/usr/local/bin:/opt/homebrew/bin\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/record.mjs\"", "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "PATH=\"$PATH:/usr/local/bin:/opt/homebrew/bin\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/record.mjs\"", "async": true }
        ]
      }
    ]
  }
}
