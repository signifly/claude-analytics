{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".source/**"]
    },
    "check": {
      "inputs": ["package.json", "scripts/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#test:root": {
      "cache": false,
      "passThroughEnv": ["TMPDIR", "SMOKE_LOKI_URL"]
    }
  }
}
