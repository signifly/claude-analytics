{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".source/**"]
    },
    "check": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#test:root": {
      "cache": false,
      "passThroughEnv": ["TMPDIR"]
    }
  }
}
