          "refId": "A",
          "expr": "sum by (kind, name, user) (count_over_time({service_name=\"claude-code-usage\", user=~\"$user\", project=~\"$project\", source=~\"$source\", kind=~\"skill|command\"} | json name=\"name\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "runs",
              "Value": "runs"
            },
            "indexByName": {
              "kind": 0,
              "name": 1,
              "user": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "runs",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
